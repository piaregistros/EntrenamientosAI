import React, { useState } from 'react';
import {
  ArrowLeft,
  ArrowRight,
  Check,
  Dumbbell,
  HeartPulse,
  Play,
  Sparkles,
  Timer,
  Target,
  X,
} from 'lucide-react';
import { apiFetch } from '../../lib/api';

interface OnboardingProps {
  user: any;
  onComplete: () => void;
  onClose?: () => void;
}

const steps = [
  {
    icon: Sparkles,
    title: 'Bienvenida',
    text: 'Vamos a enseñarte cómo funciona Entrenamiento para que puedas empezar con seguridad y sin complicaciones.',
  },
  {
    icon: Target,
    title: 'Tu objetivo',
    text: 'La aplicación está pensada para ayudarte a progresar. No necesitas saber de entrenamiento: la rutina te indica qué hacer.',
  },
  {
    icon: Dumbbell,
    title: 'Tu rutina',
    text: 'Cada sesión contiene los ejercicios, series, repeticiones, esfuerzo recomendado y descansos que necesitas.',
  },
  {
    icon: Play,
    title: 'Durante el ejercicio',
    text: 'Registra cada serie. Si no conoces un ejercicio, puedes abrir su información para consultar la técnica antes de hacerlo.',
  },
  {
    icon: Timer,
    title: 'Descansos',
    text: 'Al terminar una serie, la aplicación inicia automáticamente el descanso recomendado.',
  },
  {
    icon: HeartPulse,
    title: 'Progresar con salud',
    text: 'El objetivo no es terminar cuanto antes ni levantar el máximo peso. Queremos que mejores manteniendo una técnica segura y una progresión sostenible.',
  },
];

export default function Onboarding({
  user,
  onComplete,
  onClose,
}: OnboardingProps) {
  const [step, setStep] = useState(0);
  const [saving, setSaving] = useState(false);

  const current = steps[step];
  const Icon = current.icon;
  const isLast = step === steps.length - 1;

  const finish = async () => {
    setSaving(true);

    try {
      const response = await apiFetch('/api/onboarding/complete', {
        method: 'POST',
      });

      if (!response.ok) {
        throw new Error('No se pudo guardar el onboarding.');
      }

      onComplete();
    } catch (error) {
      console.error('Onboarding completion error:', error);
      setSaving(false);
    }
  };

  return (
    <div
      id="onboarding-overlay"
      className="fixed inset-0 z-[100] bg-neutral-950 text-white flex items-center justify-center p-5"
    >
      <div className="w-full max-w-md">
        {onClose && (
          <button
            type="button"
            onClick={onClose}
            className="absolute right-5 top-5 text-neutral-500 hover:text-white"
            aria-label="Cerrar"
          >
            <X size={22} />
          </button>
        )}

        <div className="mb-8 flex gap-1.5">
          {steps.map((_, index) => (
            <div
              key={index}
              className={`h-1 flex-1 rounded-full ${
                index <= step ? 'bg-lime-400' : 'bg-neutral-800'
              }`}
            />
          ))}
        </div>

        <div className="rounded-3xl border border-neutral-800 bg-neutral-900 p-7 shadow-2xl">
          <div className="mb-7 flex h-16 w-16 items-center justify-center rounded-2xl border border-lime-500/20 bg-lime-500/10 text-lime-400">
            <Icon size={30} />
          </div>

          <p className="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-lime-400">
            Primeros pasos
          </p>

          <h1 className="text-3xl font-black tracking-tight">
            {current.title}
          </h1>

          <p className="mt-5 text-sm leading-7 text-neutral-400">
            {current.text}
          </p>

          {step === 0 && (
            <div className="mt-6 rounded-2xl border border-neutral-800 bg-neutral-950 p-4">
              <p className="text-sm font-bold text-white">
                Hola, {user?.name || 'bienvenido/a'}.
              </p>
              <p className="mt-1 text-xs leading-5 text-neutral-500">
                Te llevará menos de dos minutos.
              </p>
            </div>
          )}

          {step === 2 && (
            <div className="mt-6 space-y-2">
              {[
                'Calentamiento cuando sea necesario',
                'Ejercicios en orden',
                'Series y repeticiones',
                'Descanso entre series',
              ].map((item) => (
                <div
                  key={item}
                  className="flex items-center gap-3 rounded-xl bg-neutral-950 p-3"
                >
                  <Check size={15} className="text-lime-400" />
                  <span className="text-xs text-neutral-300">{item}</span>
                </div>
              ))}
            </div>
          )}

          {step === 3 && (
            <div className="mt-6 rounded-2xl border border-neutral-800 bg-neutral-950 p-4">
              <p className="text-xs font-bold text-neutral-300">
                Consejo importante
              </p>
              <p className="mt-2 text-xs leading-5 text-neutral-500">
                Durante las primeras semanas prioriza aprender los movimientos.
                El peso se adapta a ti; no tienes que demostrar nada.
              </p>
            </div>
          )}

          <div className="mt-8 flex items-center justify-between gap-3">
            <button
              type="button"
              onClick={() => setStep((value) => Math.max(0, value - 1))}
              disabled={step === 0 || saving}
              className="flex min-h-11 items-center gap-2 rounded-xl border border-neutral-800 px-4 text-sm font-bold text-neutral-400 disabled:opacity-20"
            >
              <ArrowLeft size={16} />
              Atrás
            </button>

            {!isLast ? (
              <button
                type="button"
                onClick={() => setStep((value) => value + 1)}
                className="flex min-h-11 items-center gap-2 rounded-xl bg-lime-400 px-5 text-sm font-black text-neutral-950"
              >
                Continuar
                <ArrowRight size={16} />
              </button>
            ) : (
              <button
                type="button"
                onClick={finish}
                disabled={saving}
                className="flex min-h-11 items-center gap-2 rounded-xl bg-lime-400 px-5 text-sm font-black text-neutral-950 disabled:opacity-60"
              >
                {saving ? 'Guardando...' : 'Empezar'}
                {!saving && <Check size={16} />}
              </button>
            )}
          </div>
        </div>

        <p className="mt-5 text-center text-[11px] text-neutral-600">
          Paso {step + 1} de {steps.length}
        </p>
      </div>
    </div>
  );
}
